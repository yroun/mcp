{
  "name": "@yroun/mcp",
  "version": "0.3.0",
  "description": "Official MCP server for Yroun — Claude/Cursor/etc. can read+write Hub pages, posts, schedules, members via Yroun Open API.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "yroun-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "yroun",
    "hub",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yroun/mcp.git"
  },
  "license": "MIT",
  "overrides": {
    "hono": "^4.13.5",
    "@hono/node-server": "^1.19.15",
    "fast-uri": "^3.1.6",
    "ip-address": "^10.7.0",
    "qs": "^6.16.0",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23"
  }
}
